# GCP
GCP_PROJECT_ID=slcc-buzz-agent-dev

# 검수 임계값 (하루당 행 수. 월요일 3일치 추출 시 자동으로 x3)
ROW_COUNT_MIN=2000
ROW_COUNT_MAX=2400

# 추출 기간이 이 일수를 넘으면 기간 확인 시 경고 (연휴 등으로 오래 실행하지 않은 경우)
MAX_PERIOD_DAYS=5

# Outlook 알림 (본인 계정 메일 주소)
OUTLOOK_RECIPIENT=your_email@atkearney.com

# 경로 (기본값 그대로 두면 됨)
SQL_QUERY_PATH=sql/unpk_query.sql
OUTPUT_DIR=output
LOG_DIR=logs
